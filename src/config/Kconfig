    bool "Override LVGL stdlib malloc with EOS allocator"
    default y

config EOS_MEM_TRACK_ENABLE
    bool "Enable memory tracking"
    default y

endmenu

menu "Image cache"

config EOS_CACHE_ENABLE
    bool "Enable LVGL image decode cache"
    default y
    help
      When enabled, decoded image pixel data is cached to avoid
      re-decoding.  The cache is initialised during system startup.

      Disable this on platforms where the cache budget (EOS_CACHE_SIZE)
      cannot accommodate the largest decoded image (e.g. high-resolution
      QR codes on a simulator with a 128 KB budget).

config EOS_CACHE_SIZE
    int "Cache memory budget (bytes)"
    default 131072
    depends on EOS_CACHE_ENABLE
    help
      Default: 128 KB.  If IMAGE_CACHE_IN_PSRAM_SIZE or
      IMAGE_CACHE_IN_SRAM_SIZE is defined, that value is used
      automatically.

config EOS_CACHE_HEADER_COUNT
    int "Max cached image header entries"
    default 16
    depends on EOS_CACHE_ENABLE

config EOS_CACHE_USE_DEDICATED_MEM
    bool "Use dedicated memory pool for cache"
    default BSP_USING_PSRAM || IMAGE_CACHE_IN_PSRAM_SIZE
    depends on EOS_CACHE_ENABLE

endmenu

