menu "File system"

config EOS_SYS_ROOT_DIR
    string "System root directory"
    default "/"
    help
      Root directory for all file system operations.

      On MCU:
        Usually "/" (flash root).  LVGL paths (e.g. "Z:font.ttf") are
        mapped through the LVGL FS driver letter and do NOT go through
        this root.

      On Native / WASM simulator:
        Must point to the simulator's fs/ data directory, otherwise the
        system cannot find resources (fonts, images, config files) and
        will fail to boot.
        A typical CMakeLists.txt already sets this via
          add_compile_definitions(EOS_SYS_ROOT_DIR="${CMAKE_SOURCE_DIR}/fs/").
        Override here only if you need a custom location.

choice
    prompt "File system interface"
    default EOS_FS_POSIX

config EOS_FS_POSIX
    bool "POSIX"

config EOS_FS_FATFS
    bool "FatFs"

config EOS_FS_LITTLEFS
    bool "LittleFS"

config EOS_FS_RTTHREAD
    bool "RT-Thread DFS"

config EOS_FS_CUSTOM
    bool "Custom FS"
endchoice

config EOS_FS_PATH_MAX
    int "Maximum file path length"
    default 256

config EOS_LVGL_FS_LETTER
    int "LVGL file system drive letter (ASCII code, 65='A', 90='Z')"
    range 65 90
    default 90
    help
      Drive letter encoded as ASCII code of an uppercase letter.
      The value must match LV_FS_DEFAULT_DRIVE_LETTER in lv_conf.h.
      Example: 90 = 'Z' (recommended), 65 = 'A' (STDIO default).

config EOS_DFW_ENABLE
    bool "Enable delayed file writer"
    default n

endmenu

