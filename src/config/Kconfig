menu "Memory"

choice
    prompt "Memory allocation provider"
    default EOSCFG_MEM_STDLIB

config EOSCFG_MEM_STDLIB
    bool "Standard C library (malloc / free)"

config EOSCFG_MEM_AUTO
    bool "Automatic (fast pool + large pool)"

config EOSCFG_MEM_CUSTOM
    bool "Custom (override eos_malloc_core etc.)"
endchoice

config EOS_MEM_ALLOC_PROVIDER
    int
    default 0 if EOSCFG_MEM_STDLIB
    default 1 if EOSCFG_MEM_AUTO
    default 2 if EOSCFG_MEM_CUSTOM
    default 0

config EOS_MEM_POOL_ALLOC_THRESHOLD
    int "Pool allocation threshold (bytes)"
    default 32768
    depends on EOSCFG_MEM_AUTO

config EOS_OVERRIDE_LVGL_STDLIB_MALLOC_ENABLE
    bool "Override LVGL stdlib malloc with EOS allocator"
    default y

config EOS_MEM_TRACK_ENABLE
    bool "Enable memory tracking"
    default y

config EOS_MEM_TRACK_TABLE_SIZE
    int "Memory track table size (entries)"
    default 4096
    depends on EOS_MEM_TRACK_ENABLE
    help
      Number of entries in the memory tracking table.  Each tracked
      allocation occupies one entry.  Complex UIs may need more than
      the default 4096 — increase if you see "Memory track table full"
      warnings.  Simulator builds with large UIs may need 8192+.

endmenu

menu "Image cache"

config EOS_CACHE_ENABLE
    bool "Enable LVGL image decode cache"
    default y
    help
      When enabled, decoded image pixel data is cached to avoid
      re-decoding.  The cache is initialised during system startup.

      Disable this on platforms where the cache budget (EOS_CACHE_SIZE)
      cannot accommodate the largest decoded image (e.g. high-resolution
      QR codes on a simulator with a 128 KB budget).

config EOS_CACHE_SIZE
    int "Cache memory budget (bytes)"
    default 393216
    depends on EOS_CACHE_ENABLE
    help
      Default: 384 KB (393216 bytes).  Must be large enough to hold the
      largest decoded image; otherwise that image can never be cached and
      will fail to display.

      Simulator (390×450): a full-screen ARGB8888 image is ~702 KB,
      RGB565 ~351 KB, a typical QR code ~156 KB.

      MCU targets should set this based on available PSRAM/SRAM.
      If IMAGE_CACHE_IN_PSRAM_SIZE or IMAGE_CACHE_IN_SRAM_SIZE is
      defined, that value is used automatically.

config EOS_CACHE_HEADER_COUNT
    int "Max cached image header entries"
    default 16
    depends on EOS_CACHE_ENABLE

config EOS_CACHE_USE_DEDICATED_MEM
	bool "Use dedicated memory pool for cache"
	default y if BSP_USING_PSRAM
	default y if IMAGE_CACHE_IN_PSRAM_SIZE
	default n
	depends on EOS_CACHE_ENABLE

endmenu

